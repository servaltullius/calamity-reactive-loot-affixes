@@ -724,15 +724,15 @@ namespace REL {
             _instance._filename = _instance._filePath = a_filename.data();
             _instance._version = a_version;
             if (a_runtime == Runtime::Unknown) {
-                switch (a_version[1]) {
-                    case 4:
-                        _instance._runtime = Runtime::VR;
