                 _version = *version;
-                switch (_version[1]) {
-                    case 4:
-                        _runtime = Runtime::VR;
-                        break;
-                    case 6:
-                        _runtime = Runtime::AE;
-                        break;
-                    default:
-                        _runtime = Runtime::SE;
+                // Minor version 4 = VR, 5 = SE, 6+ = AE. AE 1.7.x bumped the
+                // minor version itself, so an exact match on 6 would
